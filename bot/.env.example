# Copiez ce fichier vers bot/.env puis renseignez les valeurs réelles.
# bot/.env est exclu du versionnement (voir bot/.gitignore).
# Sur Plesk, ces variables se configurent dans l'UI de l'app Node.js.

# Token du bot (portail Discord > Application > Bot > Reset Token)
DISCORD_TOKEN=

# ID du serveur Discord surveillé (mode développeur > clic droit sur le serveur > Copier l'ID)
GUILD_ID=

# URL du webhook du site (compteur de membres)
SITE_WEBHOOK_URL=https://highlanderfrance.tf/api/discord/member-count

# Token partagé, doit correspondre à DISCORD_WEBHOOK_TOKEN du config/.env du site
SITE_WEBHOOK_TOKEN=

# Port d'écoute du serveur HTTP keep-alive (imposé par Passenger/Plesk en prod, ne pas définir là-bas)
PORT=3000

# Sync périodique de sécurité en minutes (défaut : 6h). 0 = désactivé
SYNC_INTERVAL_MINUTES=360

# Débounce anti-raid : intervalle minimum entre deux pushes déclenchés par join/leave (secondes)
MIN_PUSH_INTERVAL_SECONDS=60

# --- Page d'administration (OAuth2 Discord) ---
# Portail Discord > OAuth2 : copier Client ID et Client Secret.
# Laisser vide = page d'admin désactivée (le bot fonctionne normalement).
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=

# URI de redirection, exactement telle qu'enregistrée dans le portail Discord.
OAUTH_REDIRECT_URI=https://octave.highlanderfrance.tf/callback

# IDs des rôles autorisés à accéder au panel, séparés par des virgules.
# Vide = propriétaire du serveur uniquement.
DISCORD_ADMIN_ROLE_IDS=

# --- Annonce automatique de stream ---
# URL de l'endpoint /api/twitch-live du site Laravel (lecture du cache cron).
TWITCH_LIVE_API_URL=https://highlanderfrance.tf/api/twitch-live

# Token partagé optionnel (doit correspondre au token du site si renseigné).
TWITCH_LIVE_API_TOKEN=

# ID du salon Discord où poster l'annonce (clic droit > Copier l'ID).
STREAM_ANNOUNCE_CHANNEL_ID=1477355924002701313

# Texte de mention (ex: @everyone, @here, <@&ID_ROLE>).
STREAM_ANNOUNCE_MENTION=@everyone

# Template du message. Variables disponibles : {title}, {viewers}, {url}, {channel}.
# Entre guillemets doubles : « \n » est interprété comme saut de ligne.
STREAM_ANNOUNCE_MESSAGE="🔴 **Le stream Highlander France est en direct !**\n\n**{title}**\n👁 {viewers} spectateurs\n\n🔗 {url}"
